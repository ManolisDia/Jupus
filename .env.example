# Required — Realtime conversation layer
OPENAI_API_KEY=

# Required — LangGraph supervisor reasoning (routing, extraction, summaries)
ANTHROPIC_API_KEY=

# Optional — override defaults
JUPUS_PORT=8000
JUPUS_DB_PATH=backend/db/calendar.db
# DATABASE_URL=   # only used if db_backend is switched to "postgres" (not implemented yet)

# Optional — only needed for a public hosted deployment (Phase 9)
# JUPUS_ACCESS_TOKEN=
# PUBLIC_CLIENT_ORIGIN=

# Phase 14 — transport selection. "webrtc" (default) is the hand-rolled
# /session + /bridge path; "livekit" routes the call through LiveKit Agents.
# Migration scaffolding only — removed once LiveKit is verified live.
# JUPUS_TRANSPORT=webrtc

# Required when JUPUS_TRANSPORT=livekit — from your LiveKit Cloud project's
# Settings > Keys page (free "Build" tier is sufficient).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
