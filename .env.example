# Required — Realtime conversation layer
OPENAI_API_KEY=

# Required — LangGraph supervisor reasoning (routing, extraction, summaries)
ANTHROPIC_API_KEY=

# Optional — override defaults
JUPUS_PORT=8000
JUPUS_DB_PATH=backend/db/calendar.db
# DATABASE_URL=   # only used if db_backend is switched to "postgres" (not implemented yet)

# Optional — only needed for a public hosted deployment (Phase 9)
# JUPUS_ACCESS_TOKEN=
# PUBLIC_CLIENT_ORIGIN=

# Required — the call's transport (Phase 14). From your LiveKit Cloud
# project's Settings > Keys page; the free "Build" tier is sufficient.
# Without these the backend still boots for admin/eval work, but no call can
# connect and the agent worker logs a warning and does not start.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
